# 云购生活数仓一键部署环境变量示例
# 复制为 .env 后按需修改：cp .env.example .env
# .env 已被 .gitignore 排除，严禁提交真实密钥到 Git

# ---------- MySQL ----------
MYSQL_ROOT_PASSWORD=root
MYSQL_HOST_PORT=3307

# ---------- ClickHouse ----------
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=

# ---------- Superset ----------
SUPERSET_SECRET_KEY=please-change-this-secret-key-in-env

# ---------- 大模型（NL2SQL LLM 引擎，可选） ----------
# 不配置时自动回退规则引擎，问答功能仍可用
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# ---------- Streamlit 应用 ----------
# 容器内：mysql（查 MySQL 报表镜像库）；宿主机调试：hive（docker exec beeline）
NL2SQL_BACKEND=mysql
