{
  "ydsh_ads.ads_kpi_overview": {
    "description": "核心KPI总览，单行表：GMV/订单量/客单价/活跃用户/复购率等",
    "columns": [
      {
        "name": "stat_period",
        "type": "string",
        "comment": "统计周期"
      },
      {
        "name": "gmv",
        "type": "double",
        "comment": "有效GMV（已支付+已完成）"
      },
      {
        "name": "orders",
        "type": "bigint",
        "comment": "有效订单量"
      },
      {
        "name": "aov",
        "type": "double",
        "comment": "客单价 = GMV/订单量"
      },
      {
        "name": "active_users",
        "type": "bigint",
        "comment": "活跃用户数（有下单行为）"
      },
      {
        "name": "repurchase_rate",
        "type": "double",
        "comment": "复购率 = 下单≥2次用户/下单用户"
      },
      {
        "name": "avg_orders_user",
        "type": "double",
        "comment": "人均下单次数"
      },
      {
        "name": "category_top",
        "type": "string",
        "comment": "GMV 第一品类"
      },
      {
        "name": "category_share",
        "type": "double",
        "comment": "第一品类GMV占比"
      },
      {
        "name": "store_top",
        "type": "string",
        "comment": "GMV 第一门店"
      },
      {
        "name": "refund_rate",
        "type": "double",
        "comment": "退款率 = 退款中订单/全部订单"
      }
    ]
  },
