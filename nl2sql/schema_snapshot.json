        "comment": "M：累计GMV"
      },
      {
        "name": "r_score",
        "type": "int",
        "comment": "R 得分 1-4（越大越近）"
      },
      {
        "name": "f_score",
        "type": "int",
        "comment": "F 得分 1-4（越大越频繁）"
      },
      {
        "name": "m_score",
        "type": "int",
        "comment": "M 得分 1-4（越大越高价值）"
      },
      {
        "name": "segment",
        "type": "string",
        "comment": "价值分层：重要价值/重要保持/一般价值/流失预警"
      }
    ]
  },
  "ydsh_dws.dws_order_1d": {
    "description": "日粒度全站汇总（GMV/订单量/有效GMV/有效订单/用户数/客单价/取消率）",
