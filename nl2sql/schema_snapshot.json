      },
      {
        "name": "users",
        "type": "bigint",
        "comment": "下单用户数（去重）"
      },
      {
        "name": "aov",
        "type": "double",
        "comment": "客单价 = paid_gmv / paid_orders"
      },
      {
        "name": "cancel_rate",
        "type": "double",
        "comment": "取消率 = 已取消订单 / 订单量"
      }
    ]
  },
